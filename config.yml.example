# ===================================================================
#                      BACKUP TOOL CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# TARGETS: Define what to back up and from where.
# -------------------------------------------------------------------
targets:
  Main_Server:
    type: local

    # Paths to include (can be empty []). Use 'path:folder' to store it under 'folder/' in the archive;
    # entries that would collide there are kept under their full path instead.
    paths:
      - "/etc/opt/marzneshin:data"
      - "/var/lib/marznode:data"
      - "/var/lib/marzneshin:data"
      - "/etc/nginx/sites-available/marzneshin"
    
    # Exclude items: names or patterns; these will NOT be backed up
    exclude:
      - "mysql"
      - "*.dat"
      - "xray"
      - "sing-box"
      - "hysteria"

    database:
      enable: true
      type: mariadb # or mysql, postgresql
      container: marzneshin-db-1
      name: marzneshin
      user: root
      password: ${LOCAL_DB_PASSWORD}

  Node_Server:
    type: remote
    host: "1.1.1.1" # IP address (IPv4/IPv6) or hostname.
    port: 2223
    user: ubuntu
    
    auth:
      method: key # 'key' or 'password'
      key_path: "/root/.ssh/backup-key"
      # password: ${REMOTE_SERVER_PASSWORD} # Use for password auth (less secure).

    paths:
      - "/opt/marzban"
      - "/var/lib/marzban"
      - "/etc/haproxy:config"
    exclude:
      - "mysql"
      - "assets"
      - "xray"
      - "errors"

    database:
      enable: true
      type: mysql
      container: marzban-mysql-1
      name: marzban
      user: root
      password: ${REMOTE_DB_PASSWORD}

# -------------------------------------------------------------------
# COMPRESSION (optional): gzip (default; uses pigz when installed) or zstd (much faster).
# zstd must be installed on this server and on every remote target; a server without it
# falls back to gzip for that target (the archive is then named .tar.gz instead of .tar.zst).
# -------------------------------------------------------------------
compression:
  algorithm: gzip        # gzip | zstd
  # level: 3             # gzip: 1-9 (default 6) | zstd: 1-19 (default 3)
  # threads: 0           # zstd only: 0 = use all cores

# -------------------------------------------------------------------
# SERVICES: Define where to send the final backup archives.
# -------------------------------------------------------------------
services:
  cloudflare:
    enable: true
    worker_url: https://your-backup-worker.your-domain.workers.dev
    # Required: must match the worker's API_TOKEN secret (the worker rejects uploads without it).
    api_token: ${CLOUDFLARE_API_TOKEN}
      
  telegram:
    enable: true
    token: ${TELEGRAM_TOKEN}
    chat_id: ${TELEGRAM_CHAT_ID}
    topic_id: ${TELEGRAM_TOPIC_ID}
    send_file: false

  s3:
    enable: true
    endpoint_url: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
    bucket_name: backups
    access_key: ${S3_ACCESS_KEY}
    secret_key: ${S3_SECRET_KEY}
    generate_link: false

monitoring:
  healthcheck_url: https://hc-ping.com/uuid